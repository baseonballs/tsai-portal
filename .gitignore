# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production is TRACKED: it is the single source of non-secret production
# configuration, and it holds no secrets by construction (they are listed
# commented, as the completeness contract). Matching tsai-periodical.
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local run logs and federated docs
/.run/
/src/content/docs/

# graphify knowledge-graph index — generated, regenerable via `graphify update .`
graphify-out/
.graphifyignore

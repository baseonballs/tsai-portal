{
  "name": "tsai-portal",
  "version": "2.0.8",
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "[ -f ./scripts/copy-docs.sh ] && bash ./scripts/copy-docs.sh || true && next build",
    "start": "next start",
    "lint": "eslint && pnpm run check:secrets && pnpm run test:redirect-safety && pnpm run check:purple",
    "daemon:start": "./scripts/portal-daemon.sh start",
    "daemon:stop": "./scripts/portal-daemon.sh stop",
    "daemon:restart": "./scripts/portal-daemon.sh restart",
    "daemon:status": "./scripts/portal-daemon.sh status",
    "check:secrets": "node scripts/check-no-hardcoded-credentials.mjs",
    "check:purple": "node scripts/check-no-purple.mjs",
    "test:redirect-safety": "node src/lib/auth/safe-internal-next-path.test.mjs",
    "test:coppa-scout-bridge": "npx tsx src/lib/legal/coppa-scout-consent-bridge.test.mjs",
    "test:roster-import": "npx tsx src/lib/roster/gamesheet-roster-service.test.mjs",
    "test:club-rev-share": "npx tsx src/lib/billing/club-rev-share.test.mjs",
    "test:multi-sheet-director": "npx tsx scripts/test-multi-sheet-command-center.ts",
    "test:ical-provisioner": "npx tsx scripts/test-ical-tournament-provisioner.ts",
    "test:club-monetization": "npx tsx scripts/test-club-monetization.ts",
    "test:club-revshare-dashboard": "npx tsx scripts/test-club-revshare-dashboard.ts",
    "test:live-broadcast-player": "npx tsx scripts/test-live-broadcast-player.ts",
    "test:milestone-toast": "npx tsx scripts/test-milestone-notification-toast.ts",
    "test:arena-scoreboard-banner": "npx tsx scripts/test-arena-scoreboard-banner.ts",
    "test:tournament-embed": "npx tsx scripts/test-public-tournament-embed.ts",
    "test:college-scout-discovery": "npx tsx scripts/test-college-scout-discovery.ts",
    "test:tournament-tiebreaker": "npx tsx scripts/test-tournament-tiebreaker.ts",
    "test:schedule-compensator": "npx tsx scripts/test-schedule-compensator.ts",
    "test:stream-failover": "npx tsx scripts/test-stream-failover-monitor.ts",
    "test:broadcast-cloud-switcher": "npx tsx scripts/test-broadcast-cloud-switcher.ts",
    "test:bracket-highlight-slicer": "npx tsx scripts/test-bracket-highlight-slicer.ts",
    "test:tournament-live-ticker": "npx tsx src/scripts/test-tournament-live-ticker.ts",
    "test:magnetic-telestration": "npx tsx scripts/test-magnetic-telestration-canvas.ts",
    "test:powerplay-umbrella": "npx tsx scripts/test-powerplay-umbrella-canvas.ts",
    "test:goal-line-projection": "npx tsx scripts/test-goal-line-orthogonal-review-canvas.ts",
    "test:multi-rink-broadcast-director": "npx tsx scripts/test-multi-rink-broadcast-director.ts",
    "test": "pnpm run test:redirect-safety && pnpm run test:coppa-scout-bridge && pnpm run test:roster-import && pnpm run test:club-rev-share && pnpm run test:multi-sheet-director && pnpm run test:ical-provisioner && pnpm run test:club-monetization && pnpm run test:club-revshare-dashboard && pnpm run test:live-broadcast-player && pnpm run test:milestone-toast && pnpm run test:arena-scoreboard-banner && pnpm run test:tournament-embed && pnpm run test:college-scout-discovery && pnpm run test:tournament-tiebreaker && pnpm run test:schedule-compensator && pnpm run test:stream-failover && pnpm run test:broadcast-cloud-switcher && pnpm run test:bracket-highlight-slicer && pnpm run test:tournament-live-ticker && pnpm run test:magnetic-telestration && pnpm run test:powerplay-umbrella && pnpm run test:goal-line-projection && pnpm run test:multi-rink-broadcast-director"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^1.24.0",
    "next": "16.3.2",
    "next-mdx-remote": "^6.0.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
